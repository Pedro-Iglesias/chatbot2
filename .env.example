# =============================================
# .env.example - Chatbot IFES (Atualizado 13/04/2026)
# Copie este arquivo para .env e preencha os valores
# =============================================

# ==================== GEMINI API ====================
GEMINI_API_KEY=sua_chave_aqui

# ==================== BANCO DE DADOS ====================
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot2026

# Configuracao local (Django na maquina + PostgreSQL no Docker)
# A porta deve casar com o docker-compose.yml ("5544:5432")
DB_HOST=127.0.0.1
DB_PORT=5544

# ==================== DJANGO ====================
# SECRET_KEY e POSTGRES_PASSWORD sao OBRIGATORIOS: sem eles o Django nao sobe.
SECRET_KEY=django-insecure-troque-por-uma-chave-muito-grande-e-secreta-aqui-123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== MODELOS DO GEMINI ====================
# Modelos atuais usados pelo projeto
CHAT_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
TOP_K=5